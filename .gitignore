# Dependencies
/node_modules

# Environment files
.env
.env.*
!.env.example
src/.env.*
!src/.env.example
!src/.env

# WebView2 & Edge runtime user data
/.app_data/

# Temporary archives & Pro Addon packages
*.zip
/dist/
domains-code.zip

# Pro Addon Files (Custom Domains - dynamically downloaded on upgrade)
src/app/Http/Controllers/Api/DomainController.php
src/app/Models/CustomDomain.php
src/app/Services/DomainValidationService.php
src/public/js/domains.js
src/resources/views/partials/domains_*.blade.php
src/routes/domains.php

# Database Migrations (Lite uses schema file instead of migration files)
src/database/migrations/*.php
!src/database/migrations/.gitkeep

# Laravel storage & cache
src/storage/*.key
src/storage/framework/cache/data/*
src/storage/framework/sessions/*
src/storage/framework/views/*
src/storage/logs/*
!src/storage/framework/cache/data/.gitignore
!src/storage/framework/sessions/.gitignore
!src/storage/framework/views/.gitignore
!src/storage/logs/.gitignore

# PHPUnit & testing caches
.phpunit.result.cache
src/.phpunit.result.cache
src/.phpunit.cache/

# System and OS files
.DS_Store
Thumbs.db

# Binary executables downloaded dynamically on first boot
src/bin/**/*.exe
src/bin/**/*.tmp
!src/bin/**/.gitkeep

*.log
*.sqlite-journal
status.json
